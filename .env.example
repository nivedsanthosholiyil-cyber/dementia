# Supabase project settings (safe to expose in the browser when RLS is enabled).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Or, for newer Supabase projects:
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# VITE_SUPABASE_KEY=your-publishable-or-anon-key
# The Vite config also accepts public values supplied by the Supabase/Vercel
# integration as SUPABASE_URL and SUPABASE_ANON_KEY. Never use service-role.
